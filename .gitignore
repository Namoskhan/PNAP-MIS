# Environment files — these hold real credentials (SMTP passwords,
# JWT secrets, database URIs) and must never be committed.
# .env.example is the tracked template and carries placeholders only.
.env
.env.*
!.env.example

# Dependencies — reinstall with `npm install`, never commit.
# Matches at any depth: pnap-mis/, pnap-mis/web/, pnap-mis/server/.
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
.vite/
*.tsbuildinfo

# Test / tooling caches
coverage/
.eslintcache

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

./pnap-mis/node_modules

# Generated performance-test browser profiles and caches
performance-tests/**/*chrome-profile*/
performance-tests/**/*capture-profile*/
performance-tests/**/test-launch-profile/
performance-tests/**/temp_chrome*/
performance-tests/**/Crashpad/
performance-tests/**/GPUCache/
performance-tests/**/ShaderCache/
performance-tests/**/GrShaderCache/
performance-tests/**/DawnGraphiteCache/
performance-tests/**/DawnWebGPUCache/
performance-tests/**/Code Cache/
performance-tests/**/*.dmp
performance-tests/**/*.pma
performance-tests/**/*.crdownload

# Generated Playwright and screenshot output
performance-tests/**/playwright-report/
performance-tests/**/blob-report/
performance-tests/**/test-results/
performance-tests/**/.playwright/
performance-tests/**/screenshots/

# Regenerable performance reports, raw captures, and temporary output
performance-tests/final-management-report/report.html
performance-tests/**/raw-results/
performance-tests/**/tmp/
performance-tests/**/temp/
performance-tests/**/*-trace.json
performance-tests/**/*-profile.json
performance-tests/**/*.cpuprofile
performance-tests/**/*.heapprofile
performance-tests/**/*.heapsnapshot
performance-tests/**/*.log
