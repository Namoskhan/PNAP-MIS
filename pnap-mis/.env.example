# ===================================================================
# PNAP-MIS Environment Configuration Guide
# ===================================================================
#
# This project is a monorepo containing:
#   - server: Node.js / Express backend API (default port: 5000)
#   - web:    Vite / React frontend application (default port: 5173)
#
# Quick setup:
#   1. Copy `server/.env.example` to `server/.env`
#   2. Copy `web/.env.example` to `web/.env`
#   3. Update credentials and secrets as needed
#   4. For Docker Compose: copy `.env.docker.example` to `.env` (or set environment variables)
#
# ───────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION (server/.env)
# ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/pnap_mis
JWT_SECRET=dev-only-secret-change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
APP_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PNAP MIS <no-reply@example.com>
AUTH_RATE_LIMIT=0
REGISTER_RATE_LIMIT=0
API_RATE_LIMIT=0

# ───────────────────────────────────────────────────────────────────
# WEB CONFIGURATION (web/.env)
# ───────────────────────────────────────────────────────────────────
VITE_PORT=5173
VITE_BACKEND_URL=http://localhost:5000
VITE_API_BASE_URL=/api
