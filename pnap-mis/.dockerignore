# Version control
.git
.gitignore

# Dependencies (will be freshly installed in container)
node_modules
**/node_modules
mobile
.pnpm-store
.yarn

# Local environment & secrets
.env
.env.*
!.env.example
*.local

# Local build artifacts
dist
**/dist
dist-ssr
build
.vite

# Local uploads & exports
server/uploads/*
!server/uploads/.gitkeep
server/exports/*
!server/exports/.gitkeep
uploads
exports

# Logs & debug files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode
.idea
.claude
.DS_Store
Thumbs.db

# Documentation & scratch files
output.txt
system.txt
*.tmp
