# PNAP MIS Mobile App — Environment Variables
# Copy this file to .env and fill in your values.

# Backend API URL.
# For local development on a PHYSICAL DEVICE: use your PC's LAN IP (not localhost).
# For Android emulator: use http://10.0.2.2:5000/api
# For iOS Simulator: http://localhost:5000/api is fine.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000/api
