# ── Server & Environment ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/pnap_mis

# ── Security & Authentication ──────────────────────────────────────
# Secret key used to sign JWTs. In production, use a strong random string (e.g. openssl rand -base64 32)
JWT_SECRET=dev-only-secret-change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Allowed CORS origins (comma-separated).
# Defaults cover the officeholder MIS (5173) and the standalone public portal (5174).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Public base URL of the web client.
# Email verification and password reset links are built from this URL.
APP_URL=http://localhost:5173

# ── Uploads & Media Storage ────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ── Outbound Mail (SMTP) ───────────────────────────────────────────
# Leave SMTP_HOST blank in development; emails will log to the server console instead of sending.
#
# For Gmail: host smtp.gmail.com, port 587, and an App Password (not your normal password).
# App Passwords require 2-Step Verification and are generated at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PNAP MIS <no-reply@example.com>
# Optional: force implicit TLS (defaults to true for port 465, false for port 587).
# SMTP_SECURE=false

# ── Rate Limiting (Requests per 15 min per IP) ──────────────────────
# Auth rate limiting for account-security endpoints (forgot-password, reset, verify, resend):
# 0 disables rate limiting in dev; defaults to 5 in prod.
AUTH_RATE_LIMIT=0

# Rate limiting for public self-registration (window: 1 hour):
# 0 disables rate limiting in dev; defaults to 10 in prod.
REGISTER_RATE_LIMIT=0

# Global API rate limit:
# 0 disables rate limiting in dev; defaults to 600 in prod.
API_RATE_LIMIT=0
