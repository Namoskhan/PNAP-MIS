# ── Docker Compose Environment Configuration (Template) ───────────────
# Copy this file to .env before running docker compose:
#   cp .env.docker.example .env

# Application Server
NODE_ENV=production
PORT=5000
HOST_PORT=80

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>/pnap_mis?retryWrites=true&w=majority

# Security
JWT_SECRET=replace_with_a_secure_long_random_jwt_secret

# Origins
CORS_ORIGIN=*
CLIENT_ORIGIN=*
