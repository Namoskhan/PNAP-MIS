# ── Vite Web Client Configuration ──────────────────────────────────
# Port on which the Vite dev server runs
VITE_PORT=5173

# Target URL for backend proxy (used during development by Vite proxy)
VITE_BACKEND_URL=http://localhost:5000

# API base path (defaults to '/api' for proxy or same-domain production setup).
# Set to an absolute URL (e.g., 'http://localhost:5000/api') if hosting the API on a separate origin without a reverse proxy.
VITE_API_BASE_URL=/api

# Optional: Specific overrides for auth/public base URLs if routed differently
# VITE_AUTH_API_BASE_URL=/api/auth
# VITE_PUBLIC_API_BASE_URL=/api/public
