PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pnap_mis
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Public base URL of the web client. Email verification and password
# reset links are built from this.
APP_URL=http://localhost:5173

# SMTP. This file is COMMITTED — put placeholders here and real
# credentials in .env (which is gitignored), never the other way round.
#
# Leave SMTP_HOST blank in development and the mailer prints the message
# (and the link) to the server console instead of sending.
#
# For Gmail: host smtp.gmail.com, port 587, and an App Password — not
# your account password. App Passwords require 2-Step Verification and
# are generated at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PNAP MIS <no-reply@example.com>
# Optional: force implicit TLS. Defaults to true only on port 465.
# SMTP_SECURE=false

# Optional: requests per 15 min per IP for the account-security
# endpoints (forgot password / reset / verify / resend). Defaults are
# tight; raise only if you have a reason.
# AUTH_RATE_LIMIT=5
