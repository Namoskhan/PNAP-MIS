{
  "name": "pnap-mis",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace=web",
    "start": "npm start --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm --prefix mobile run start",
    "build:mobile:apk": "npm --prefix mobile run build:apk",
    "build:mobile:aab": "npm --prefix mobile run build:aab",
    "dev": "npm-run-all --parallel dev:server dev:web",
    "seed": "npm run seed --workspace=server",
    "seed:all": "npm run seed:all --workspace=server",
    "seed:demo": "npm run seed:demo --workspace=server",
    "export:demo": "npm run export:demo --workspace=server",
    "import:credentials": "npm run import:credentials --workspace=server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
